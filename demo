#!/usr/bin/env bash
# The entry point. On stage the only key pressed is next: right arrow, Enter or
# space.
#
#   ./demo            from the top
#   ./demo 2.3        jump to a step (earlier ones run silently)
#   ./demo --list     show every step
#   ./demo --reset    tear the workloads down and start over

set -uo pipefail
DEMO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DEMO_ROOT
cd "$DEMO_ROOT"

# shellcheck source=lib/demo.sh
. "$DEMO_ROOT/lib/demo.sh"
# shellcheck source=lib/story.sh
. "$DEMO_ROOT/lib/story.sh"
# shellcheck source=steps/incident1.sh
. "$DEMO_ROOT/steps/incident1.sh"
# shellcheck source=steps/incident2.sh
. "$DEMO_ROOT/steps/incident2.sh"

demo_main "$@"
