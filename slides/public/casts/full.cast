[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2;1H  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThree replicas, 10-second warmup, /work doing a real query against RDS.\u001b[39m\u001b[12X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTouching liveness?\u001b[39m\u001b[65X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhy? It is green.\u001b[39m\u001b[66X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mIt goes to the database through the same pool as /work.\u001b[39m\u001b[28X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mPool of four, the query is trivial. Ship it.\u001b[39m\u001b[39X\u001b[7;103H\u001b[1K\r\n  \u001b[1mwhat changes: 12-startup-probe.yaml -> 13-under-load.yaml\u001b(B\u001b[m\u001b[44X\r\n  \u001b[36m@@ -1,14 +1,11 @@\u001b[39m\u001b[84X\r\n  \u001b[31m-# Incident 1, step 1.2, second half -- Madina read the documentation.\u001b[39m\u001b[31X\r\n  \u001b[32m+# Incident 1, step 1.3 -- the production configuration, and the first real traffic.\u001b[39m\u001b[17X\r\n   #\u001b[99X\r\n  \u001b[31m-# startupProbe gives the slow start its own budget: 60 checks at 2 seconds is\u001b[39m\u001b[23X\r\n  \u001b[31m-# two minutes of patience, and while it runs, liveness is"]
[0.000, "o", " not consulted at all.\u001b[39m\u001b[21X\r\n  \u001b[31m-# The liveness numbers can then be about steady-state health, which is the only\u001b[39m\u001b[21X\r\n  \u001b[31m-# thing they were ever meant to be about.\u001b[39m\u001b[59X\r\n  \u001b[32m+# The start is fixed, so the warmup drops to 10 seconds and the replica count\u001b[39m\u001b[23X\r\n  \u001b[32m+# goes to three. Nobody touched the liveness probe, because it is green.\u001b[39m\u001b[28X\r\n   #\u001b[99X\r\n  \u001b[31m-# WARMUP_SECONDS is 50 rather than 15 on purpose, and it has to match the value\u001b[39m\u001b[21X\r\n  \u001b[31m-# the previous step broke the service with: the point of this step is that the\u001b[39m\u001b[22X\r\n  \u001b[31m-# same slow start that was being punished a minute ago is now simply waited for.\u001b[39m\u001b[20X\r\n  \u001b[31m-# It used to say 30 here while the script claimed 60 out loud, which made the\u001b[39m\u001b[23X\r\n  \u001b[31m-# apply quietly undo the breakage the step was built on.\u001b[39m\u001b[44X\r\n  \u001b[32m+# HEALTHZ_MODE=db is the whole step: /healthz now queues for the same worker\u001b[39m\u001b[24X\r\n  \u001b[32m+# slot and the same pooled connection that /work is usin"]
[0.000, "o", "g. Under load the queue\u001b[39m\u001b[21X\r\n  \u001b[32m+# grows past timeoutSeconds: 1, three checks in a row miss, and kubelet restarts\u001b[39m\u001b[20X\r\n  \u001b[32m+# three entirely healthy replicas for being busy.\u001b[39m\u001b[51X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -17,5 +14,5 @@\u001b[39m metadata:\u001b[74X\r\n     namespace: demo\u001b[83X\r\n   spec:\u001b[95X\r\n  \u001b[31m-  replicas: 1\u001b[39m\u001b[87X\r\n  \u001b[32m+  replicas: 3\u001b[39m\u001b[87X\r\n     strategy:\u001b[89X\r\n       type: Recreate\u001b[82X\r\n  \u001b[36m@@ -38,7 +35,11 @@\u001b[39m spec:\u001b[77X\u001b[39;13H\u001b[1K\u001b[Cenv:\u001b[86X\u001b[40;15H\u001b[1K\u001b[C- name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-\u001b[14X\u001b[14Cvalue: \"50\"\u001b[39m\u001b[75X\r\n  \u001b[32m+\u001b[14X\u001b[14Cvalue: \"10\"\u001b[39m\u001b[75X\r\n  \u001b[32m+\u001b[12X\u001b[12C- name: WORK_LATENCY_MS\u001b[39m\u001b[65X\r\n  \u001b[32m+\u001b[39m\u001b[100X\u001b[?12l\u001b[?25h\u001b[?2026l\u001b[?2026h\r\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[32m+# goes to three. Nobody touched the liveness probe, because it is green.\u001b[39m\u001b[28X\r\n   #\u001b[99X\r\n  \u001b[31m-# WARMUP_SECONDS is 50 rather than 15 on purpose, and it has to match the value\u001b[39m\u001b[21X\r\n  \u001b[31m-# the previous step broke the service with: the point of this step is that the\u001b[39m\u001b[22X\r\n  \u001b[31m-# same slow start that was being punished a minute ago is now simply waited for.\u001b[39m\u001b[20X\r\n  \u001b[31m-# It used to say 30 here while the script claimed 60 out loud, which made the\u001b[39m\u001b[23X\r\n  \u001b[31m-# apply quietly undo the breakage the step was built on.\u001b[39m\u001b[44X\r\n  \u001b[32m+# HEALTHZ_MODE=db is the whole step: /healthz now queues for the same worker\u001b[39m\u001b[24X\r\n  \u001b[32m+# slot and the same pooled connection that /work is using. Under load the queue\u001b[39m\u001b[21X\r\n  \u001b[32m+# grows past timeoutSeconds: 1, three checks in a row miss, and kubelet restarts\u001b[39m\u001b[20X\r\n  \u001b[32m+# three entirely healthy replicas for being busy.\u001b[39m\u001b[51X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -17,"]
