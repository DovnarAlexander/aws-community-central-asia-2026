[0.023, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[13S\u001b[2;44r\u001b[s\u001b[31;1H  \u001b[36m@@ -1,14 +1,11 @@\r\n\u001b[39m  \u001b[31m-# Incident 1, step 1.2, second half -- Madina read the documentation.\u001b[39m\u001b[31X\r\n  \u001b[32m+# Incident 1, step 1.3 -- the production configuration, and the first real traffic.\u001b[39m\u001b[17X\r\n   #\u001b[99X\r\n  \u001b[31m-# startupProbe gives the slow start its own budget: 60 checks at 2 seconds is\u001b[39m\u001b[23X\r\n  \u001b[31m-# two minutes of patience, and while it runs, liveness is not consulted at all.\u001b[39m\u001b[21X\r\n  \u001b[31m-# The liveness numbers can then be about steady-state health, which is the only\u001b[39m\u001b[21X\r\n  \u001b[31m-# thing they were ever meant to be about.\u001b[39m\u001b[59X\r\n  \u001b[32m+# The start is fixed, so the warmup drops to 10 seconds and the replica count\u001b[39m\u001b[23X\r\n  \u001b[32m+# goes to three. Nobody touched the liveness probe, because it is green.\u001b[39m\u001b[28X\r\n   #\u001b[99X\r\n  \u001b[31m-# WARMUP_SECONDS is 50 rather than 15 on purpose, and it has to match the value\u001b[39m\u001b[21X\r\n  \u001b[31m-# the previous step broke the service with: the point of this step is"]
[0.000, "o", " that the\u001b[39m\u001b[22X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[20S\u001b[2;44r\u001b[s\u001b[24;1H  \u001b[31m-# same slow start that was being punished a minute ago is now simply waited for.\r\n\u001b[39m  \u001b[31m-# It used to say 30 here while the script claimed 60 out loud, which made the\u001b[39m\u001b[23X\r\n  \u001b[31m-# apply quietly undo the breakage the step was built on.\u001b[39m\u001b[44X\r\n  \u001b[32m+# HEALTHZ_MODE=db is the whole step: /healthz now queues for the same worker\u001b[39m\u001b[24X\r\n  \u001b[32m+# slot and the same pooled connection that /work is using. Under load the queue\u001b[39m\u001b[21X\r\n  \u001b[32m+# grows past timeoutSeconds: 1, three checks in a row miss, and kubelet restarts\u001b[39m\u001b[20X\r\n  \u001b[32m+# three entirely healthy replicas for being busy.\u001b[39m\u001b[51X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -17,5 +14,5 @@\u001b[39m metadata:\u001b[74X\r\n     namespace: demo\u001b[83X\r\n   spec:\u001b[95X\r\n  \u001b[31m-  replicas: 1\u001b[39m\u001b[87X\r\n  \u001b[32m+  replicas: 3\u001b[39m\u001b[87X\r\n     strategy:\u001b[89X\r\n       type: Recreate\u001b[82X\r\n  \u001b[36m@@ -38,7 +35,11"]
[0.000, "o", " @@\u001b[39m spec:\u001b[77X\r\n             env:\u001b[86X\r\n               - name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-              value: \"50\"\u001b[39m\u001b[75X\r\n  \u001b[32m+     \u001b[39m\u001b[95X\u001b[1;44r\u001b[44;9H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[18S\u001b[2;44r\u001b[s\u001b[26;9H\u001b[32m         value: \"10\"\r\n\u001b[39m  \u001b[32m+            - name: WORK_LATENCY_MS\u001b[39m\u001b[65X\r\n  \u001b[32m+              value: \"200\"\u001b[39m\u001b[74X\r\n  \u001b[32m+            - name: POOL_MAX\u001b[39m\u001b[72X\r\n  \u001b[32m+              value: \"4\"\u001b[39m\u001b[76X\r\n               - name: HEALTHZ_MODE\u001b[68X\r\n  \u001b[31m-              value: \"local\"\u001b[39m\u001b[72X\r\n  \u001b[32m+              value: \"db\"\u001b[39m\u001b[75X\r\n               - name: READY_MODE\u001b[70X\r\n                 value: \"cached\"\u001b[71X\r\n  \u001b[36m@@ -58,2 +59,7 @@\u001b[39m spec:\u001b[78X\r\n               timeoutSeconds: 1\u001b[71X\r\n               failureThreshold: 3\u001b[69X\r\n  \u001b[32m+          readinessProbe:\u001b[39m\u001b[75X\r\n  \u001b[32m+            httpGet: { path: /ready, port: 8080 }\u001b[39m\u001b[51X\r\n  \u001b[32m+            periodSeconds: 5\u001b[39m\u001b[72X\r\n  \u001b[32m+            timeoutSeconds: 1\u001b[39m\u001b[71X\r\n  \u001b[32m+       "]
[0.000, "o", "     failureThreshold: 3\u001b[39m\u001b[69X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
