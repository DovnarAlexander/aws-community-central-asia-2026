[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[32m+# two minutes of patience, and while it runs, liveness is not consulted at all.\u001b[39m\u001b[21X\r\n  \u001b[32m+# The liveness numbers can then be about steady-state health, which is the only\u001b[39m\u001b[21X\r\n  \u001b[32m+# thing they were ever meant to be about.\u001b[39m\u001b[59X\r\n   #\u001b[99X\r\n  \u001b[31m-# These numbers used to be 40 against 30. They are half that now because the\u001b[39m\u001b[24X\r\n  \u001b[31m-# failure is pure arithmetic -- initialDelay + failureThreshold x period against\u001b[39m\u001b[20X\r\n  \u001b[31m-# the warmup -- and arithmetic is as true at 25 seconds as at 40. What the\u001b[39m\u001b[26X\r\n  \u001b[31m-# halving bought is most of a minute of stage time, which the theory cards now\u001b[39m\u001b[22X\r\n  \u001b[31m-# spend explaining the probe while the rollout settles.\u001b[39m\u001b[45X\r\n  \u001b[31m-#\u001b[39m\u001b[99X\r\n  \u001b[31m-# Green here:  warmup 15 < initialDelay 25, ten seconds of margin.\u001b[39m\u001b[34X\r\n  \u001b[31m-# Broken next: the step sets WARMUP_SECONDS=50 against 25 + 3x5 = 40 seconds of\u001b[39m\u001b[21X\r\n  \u001b[31m-# patience, so the kill lands at 40 and the pod would have "]
[0.000, "o", "been ready at 50.\u001b[39m\u001b[24X\r\n  \u001b[32m+# WARMUP_SECONDS is 50 rather than 15 on purpose, and it has to match the value\u001b[39m\u001b[21X\r\n  \u001b[32m+# the previous step broke the service with: the point of this step is that the\u001b[39m\u001b[22X\r\n  \u001b[32m+# same slow start that was being punished a minute ago is now simply waited for.\u001b[39m\u001b[20X\r\n  \u001b[32m+# It used to say 30 here while the script claimed 60 out loud, which made the\u001b[39m\u001b[23X\r\n  \u001b[32m+# apply quietly undo the breakage the step was built on.\u001b[39m\u001b[44X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -40,5 +38,5 @@\u001b[39m spec:\u001b[78X\u001b[23;13H\u001b[1K\u001b[Cenv:\u001b[86X\u001b[24;15H\u001b[1K\u001b[C- name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-\u001b[14X\u001b[14Cvalue: \"15\"\u001b[39m\u001b[75X\r\n  \u001b[32m+\u001b[14X\u001b[14Cvalue: \"50\"\u001b[39m\u001b[75X\u001b[27;15H\u001b[1K\u001b[C- name: HEALTHZ_MODE\u001b[68X\u001b[28;17H\u001b[1K\u001b[Cvalue: \"local\"\u001b[72X\r\n  \u001b[36m@@ -50,7 +48,11 @@\u001b[39m spec:\u001b[77X\u001b[30;13H\u001b[1K\u001b[Cresources:\u001b[80X\u001b[31;15H\u001b[1K\u001b[Crequests: { cpu: \"250m\", memory: \"64Mi\" }\u001b[47X\r\n  \u001b[32m+\u001b[10X\u001b[10CstartupProbe:\u001b[39m\u001b[77X\r\n  \u001b[32m+\u001b[12X\u001b[12ChttpGet: { "]
