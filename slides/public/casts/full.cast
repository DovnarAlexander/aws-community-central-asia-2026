[0.000, "o", "\r\nGERS        AUTHENTICATIONS   AGE\u001b[70X\r\n  worker   apps/v1.Deployment   worker\u001b[12X\u001b[12C0     24    True    False    False      False    aws-\r\nsqs-queue   sqs\u001b[15X\u001b[15C11s\u001b[70X\u001b[38;103H\u001b[1K\r\n  \u001b[37mKEDA watches the queue. Zero workers right now, because there is nothing to do.\u001b[39m\u001b[22X\r\n  \u001b[1m> load: 20 rps, enqueue (panel bottom right)\u001b(B\u001b[m\u001b[57X\r\n  \u001b[37mFilling the queue: two thousand messages a second going in.\u001b[39m\u001b[42X\u001b[42;103H\u001b[1K\r\n  \u001b[1mKEDA, AND WHAT IT IS COUNTING\u001b(B\u001b[m\u001b[72X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l\u001b[?2026h\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[2m|\u001b(B\u001b[m One pod NotReady   -> its address is removed, the rest carry the load.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m Every pod NotReady -> the slice is empty and the Service has nowhere\u001b[31X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[23X\u001b[23Cto send anything. No error, no traffic, no pods.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m So the blast radius of a readiness probe is not one replica.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m It is every replica that shares whatever the probe is asking about.\u001b[32X\u001b[8;103H\u001b[1K\n\u001b[1K\r\n  \u001b[37mThree replicas, probing every two seconds. One and a half scans per second.\u001b[39m\u001b[26X\u001b[11;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n       9 |      1 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[19;103H\u001b[1"]
[0.000, "o", "K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwelve connections out of fifty-seven. I did not even wake up.\u001b[39m\u001b[21X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAll green. Zero incidents.\u001b[39m\u001b[57X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhile there are three replicas, yes.\u001b[39m\u001b[47X\u001b[23;103H\u001b[1K\r\n  \u001b[1m-> step 2.2: Black Friday: the queue fills\u001b(B\u001b[m\u001b[59X\u001b[25;103H\u001b[1K\u001b[35m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[35m\u001b[1m\r\n  2.2 . Black Friday: the queue fills\u001b(B\u001b[m\u001b[66X\u001b[35m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[29;103H\u001b[1K\r\n  \u001b[37mBlack Friday. The work arrives -- as a queue, which is what the whole system was built for.\u001b[39m\u001b[10X\u001b[31;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo get scaledobject worker\u001b(B\u001b[m\u001b[60X\r\n  NAME     SCALETARGETKIND      SCALETARGETNAME   MIN   MAX   READY   ACTIVE   FALLBACK   PAUSED   TRIG\r\nGERS        AUTHENT"]
[0.000, "o", "ICATIONS   AGE\u001b[70X\r\n  worker   apps/v1.Deployment   worker\u001b[12X\u001b[12C0     24    True    False    False      False    aws-\r\nsqs-queue   sqs\u001b[15X\u001b[15C11s\u001b[70X\u001b[37;103H\u001b[1K\r\n  \u001b[37mKEDA watches the queue. Zero workers right now, because there is nothing to do.\u001b[39m\u001b[22X\r\n  \u001b[1m> load: 20 rps, enqueue (panel bottom right)\u001b(B\u001b[m\u001b[57X\r\n  \u001b[37mFilling the queue: two thousand messages a second going in.\u001b[39m\u001b[42X\u001b[41;103H\u001b[1K\r\n  \u001b[1mKEDA, AND WHAT IT IS COUNTING\u001b(B\u001b[m\u001b[72X\r\n  \u001b[2m|\u001b(B\u001b[m pollingInterval 5   it asks SQS how deep the queue is\u001b[46X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
