[0.010, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37m\"too many connections\". The pods are up and they are not Ready.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.009, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd a worker that cannot reach the database does not delete its message.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThe message comes back. The queue gets deeper.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.007, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[31m\u001b[1m[>_<] KEDA     \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mQueue is deeper. Adding workers.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.007, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThat is the loop.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.001, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[2S\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. THE LOOP\u001b(B\u001b[m\u001b[70X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m probe asks the DB  ->  replicas NotReady  ->  workers stop consuming\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.128, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m   ^                                                     |\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.129, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m   |                                                     v\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.129, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m  more nodes bought  <-  KEDA adds workers  <-  queue depth grows\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.129, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m \u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.130, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m Every turn adds connections to the database that is already the\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.132, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[2m|\u001b(B\u001b[m bottleneck, which makes the next turn worse. Nothing in the loop\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
