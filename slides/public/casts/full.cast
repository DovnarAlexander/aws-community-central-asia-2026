[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[2mreaching the cluster    \u001b(B\u001b[m \u001b[2m..........\u001b(B\u001b[m \u001b[32m\u001b[1mok\u001b(B\u001b[m\u001b[63X\r\n  \u001b[2mwaking the database     \u001b(B\u001b[m \u001b[2m..........\u001b(B\u001b[m \u001b[32m\u001b[1mok\u001b(B\u001b[m\u001b[63X\r\n  \u001b[2mcalling the developer   \u001b(B\u001b[m \u001b[2m..........\u001b(B\u001b[m \u001b[32m\u001b[1mok\u001b(B\u001b[m\u001b[63X\r\n  \u001b[2mcalling the DevOps      \u001b(B\u001b[m \u001b[2m..........\u001b(B\u001b[m \u001b[32m\u001b[1mok\u001b(B\u001b[m\u001b[63X\r\n  \u001b[2mhiring an intern        \u001b(B\u001b[m \u001b[2m..........\u001b(B\u001b[m \u001b[32m\u001b[1mok\u001b(B\u001b[m\u001b[63X\u001b[7;103H\u001b[1K\u001b[35m\u001b[1m\r\n=======================================================================================================\u001b(B\u001b[m\u001b[35m\u001b[1m\r\n  THE PROBE THAT KILLED ITSELF\u001b(B\u001b[m\u001b[73X\u001b[35m\u001b[1m\r\n=======================================================================================================\u001b(B\u001b[m\u001b[11;103H\u001b[1K\r\n  \u001b[2mA real cluster, a real database, real failures.\u001b(B\u001b[m\u001b[54X\r\n  \u001b[2mNothing is recorded -- including the parts that go wrong.\u001b(B\u001b[m\u001b[44X\u001b[14;103H\u001b[1K\r\n  \u001b[1mON CALL\u001b(B\u001b[m\u001b[94X\u001b[16;103H\u001b[1K\r\n  \u001b[34m\u001b[1m(o_o) Timur\u001b(B\u001b[m \u001b[2m. backend\u001b(B\u001b[m\u001b[80X\r\n        \u001b[37m\"I wrote the serv"]
[0.001, "o", "ice. It takes 10 seconds to start:\u001b[39m\u001b[44X\r\n        \u001b[37mwarms a cache, opens a pool. The probe I copied from a blog post.\u001b[39m\u001b[30X\r\n        \u001b[37mIt is green, so it is correct.\"\u001b[39m\u001b[64X\u001b[21;103H\u001b[1K\r\n  \u001b[33m\u001b[1m(-_-) Ruslan\u001b(B\u001b[m \u001b[2m. DevOps\u001b(B\u001b[m\u001b[80X\r\n        \u001b[37m\"Any production problem is a number in a YAML file.\u001b[39m\u001b[44X\r\n        \u001b[37mThe method works. It has never failed me before today.\"\u001b[39m\u001b[40X\u001b[25;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina\u001b(B\u001b[m \u001b[2m. intern\u001b(B\u001b[m\u001b[80X\r\n        \u001b[37m\"I read the documentation.\"\u001b[39m\u001b[68X\r\n        \u001b[37mNobody asks her opinion for a while.\u001b[39m\u001b[59X\u001b[29;103H\u001b[1K\r\n  \u001b[37m[o_o] kubelet\u001b[39m \u001b[2m. the executioner\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"I do not read your code. I read your manifest,\u001b[39m\u001b[48X\r\n        \u001b[37mand then I pull the trigger.\"\u001b[39m\u001b[66X\u001b[33;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres\u001b(B\u001b[m \u001b[2m. the database\u001b(B\u001b[m\u001b[72X\r\n        \u001b[37m\"Two vCPU, 54 connections you may have,\u001b[39m\u001b[56X\r\n        \u001b[37mand a great deal of patience.\"\u001b[39m\u001b[65X\u001b[37;103H\u001b[1K\r\n  \u001b[31m\u001b[1m[>_<] KED"]
[0.000, "o", "A\u001b(B\u001b[m \u001b[2m. the pod autoscaler\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"The queue is deep, so I will add workers.\"\u001b[39m\u001b[52X\r\n        \u001b[37mIt has no other ideas.\u001b[39m\u001b[73X\u001b[41;103H\u001b[1K\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m. the node autoscaler\u001b(B\u001b[m\u001b[64X\r\n        \u001b[37m\"Pods are Pending, so I will buy machines.\"\u001b[39m\u001b[52X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
