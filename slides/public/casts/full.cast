[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d        \u001b[37mNobody asks her opinion for a while.\u001b[39m\u001b[59X\u001b[3;103H\u001b[1K\r\n  \u001b[37m[o_o] kubelet\u001b[39m \u001b[2m. the executioner\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"I do not read your code. I read your manifest,\u001b[39m\u001b[48X\r\n        \u001b[37mand then I pull the trigger.\"\u001b[39m\u001b[66X\u001b[7;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres\u001b(B\u001b[m \u001b[2m. the database\u001b(B\u001b[m\u001b[72X\r\n        \u001b[37m\"Two vCPU, 57 connections you may have,\u001b[39m\u001b[56X\r\n        \u001b[37mand a great deal of patience.\"\u001b[39m\u001b[65X\u001b[11;103H\u001b[1K\r\n  \u001b[31m\u001b[1m[>_<] KEDA\u001b(B\u001b[m \u001b[2m. the pod autoscaler\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"The queue is deep, so I will add workers.\"\u001b[39m\u001b[52X\r\n        \u001b[37mIt has no other ideas.\u001b[39m\u001b[73X\u001b[15;103H\u001b[1K\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m. the node autoscaler\u001b(B\u001b[m\u001b[64X\r\n        \u001b[37m\"Pods are Pending, so I will buy machines.\"\u001b[39m\u001b[52X\r\n        \u001b[37mThis one has a credit card.\u001b[39m\u001b[68X\u001b[19;103H\u001b[1K\r\n  \u001b[2mAny resemblance to your team is coincidental. Probably.\u001b(B\u001b[m\u001b[46X\u001b[21;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1mWHAT THIS TALK IS ABOUT\u001b(B\u001b[m\u001b[78X\r\n  \u001b[2m|\u001b("]
[0.000, "o", "B\u001b[m Every container you run has something asking it questions.\u001b[41X\r\n  \u001b[2m|\u001b(B\u001b[m Not a load balancer, not a human: kubelet, every few seconds,\u001b[38X\r\n  \u001b[2m|\u001b(B\u001b[m forever, using numbers out of your manifest.\u001b[55X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m startup     has it finished booting?\u001b[63X\r\n  \u001b[2m|\u001b(B\u001b[m liveness    is it alive?        a wrong answer restarts it\u001b[41X\r\n  \u001b[2m|\u001b(B\u001b[m readiness   can it serve?       a wrong answer unplugs it\u001b[42X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m Of everything that can take a container down -- a crash, an OOM,\u001b[35X\r\n  \u001b[2m|\u001b(B\u001b[m an eviction, a rollout -- a probe is the only one that does it\u001b[37X\r\n  \u001b[2m|\u001b(B\u001b[m while the process is working perfectly well.\u001b[55X\u001b[35;103H\u001b[1K\n\u001b[1K\u001b[32m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[32m\u001b[1m\r\n  Two incidents. Both times the service was killed by a check, not by traffic.\u001b(B\u001b[m\u001b[25X\u001b[32m\u001b[1m\r\n======================================================================="]
[0.000, "o", "=============================\u001b(B\u001b[m   \u001b[40;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1m-> step 1.1: Timur ships a service\u001b(B\u001b[m\u001b[67X\u001b[43;103H\u001b[1K\n\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2;103H\u001b[1K\r\n  \u001b[37m[o_o] kubelet\u001b[39m \u001b[2m. the executioner\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"I do not read your code. I read your manifest,\u001b[39m\u001b[48X\r\n        \u001b[37mand then I pull the trigger.\"\u001b[39m\u001b[66X\u001b[6;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres\u001b(B\u001b[m \u001b[2m. the database\u001b(B\u001b[m\u001b[72X\r\n        \u001b[37m\"Two vCPU, 57 connections you may have,\u001b[39m\u001b[56X\r\n        \u001b[37mand a great deal of patience.\"\u001b[39m\u001b[65X\u001b[10;103H\u001b[1K\r\n  \u001b[31m\u001b[1m[>_<] KEDA\u001b(B\u001b[m \u001b[2m. the pod autoscaler\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"The queue is deep, so I will add workers.\"\u001b[39m\u001b[52X\r\n        \u001b[37mIt has no other ideas.\u001b[39m\u001b[73X\u001b[14;103H\u001b[1K\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m. the node autoscaler\u001b(B\u001b[m\u001b[64X\r\n        \u001b[37m\"Pods are Pending, so I will buy machines.\"\u001b[39m\u001b[52X\r\n        \u001b[37mThis one has a credit card.\u001b[39m\u001b[68X\u001b[18;103H\u001b[1K\r\n  \u001b[2mAny resemblance to your team is coincidental. Probably.\u001b(B\u001b[m\u001b[46X\u001b[20;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1mWHAT THIS TALK IS ABOUT\u001b(B\u001b[m\u001b[78X\r\n  \u001b[2m|\u001b(B\u001b[m Every container you run has something asking it questions."]
[0.000, "o", "\u001b[41X\r\n  \u001b[2m|\u001b(B\u001b[m Not a load balancer, not a human: kubelet, every few seconds,\u001b[38X\r\n  \u001b[2m|\u001b(B\u001b[m forever, using numbers out of your manifest.\u001b[55X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m startup     has it finished booting?\u001b[63X\r\n  \u001b[2m|\u001b(B\u001b[m liveness    is it alive?        a wrong answer restarts it\u001b[41X\r\n  \u001b[2m|\u001b(B\u001b[m readiness   can it serve?       a wrong answer unplugs it\u001b[42X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m Of everything that can take a container down -- a crash, an OOM,\u001b[35X\r\n  \u001b[2m|\u001b(B\u001b[m an eviction, a rollout -- a probe is the only one that does it\u001b[37X\r\n  \u001b[2m|\u001b(B\u001b[m while the process is working perfectly well.\u001b[55X\u001b[34;103H\u001b[1K\n\u001b[1K\u001b[32m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[32m\u001b[1m\r\n  Two incidents. Both times the service was killed by a check, not by traffic.\u001b(B\u001b[m\u001b[25X\u001b[32m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[39;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1"]
