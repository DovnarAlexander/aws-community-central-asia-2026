[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[32m+        queueLength: \"20\"\u001b[39m\u001b[75X\r\n  \u001b[32m+        awsRegion: ${AWS_REGION}\u001b[39m\u001b[68X\r\n  \u001b[32m+        scaleOnInFlight: \"true\"\u001b[39m\u001b[69X\u001b[5;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ envsubst < k8s/incident2/20-ready-db-each-call.yaml | kubectl apply -f -\u001b(B\u001b[m\u001b[27X\r\n  deployment.apps/svc configured\u001b[71X\r\n  deployment.apps/worker created\u001b[71X\r\n  triggerauthentication.keda.sh/sqs created\u001b[60X\r\n  scaledobject.keda.sh/worker created\u001b[66X\u001b[11;103H\u001b[1K\r\n  \u001b[37mShe does not say it out loud. She writes it down.\u001b[39m\u001b[52X\u001b[13;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. HOW A READINESS FAILURE ACTUALLY REMOVES A POD\u001b(B\u001b[m\u001b[32X\r\n  \u001b[2m|\u001b(B\u001b[m The Service does not route to pods. It routes to an EndpointSlice,\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m and readiness is what puts an address in it or takes it out.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m One pod NotReady   -> its address is removed, the rest carry the load.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m Every pod NotReady -> the slice is empty and the Service has nowhere\u001b[31X\r\n  \u001b[2m|\u001b(B"]
[0.000, "o", "\u001b[m\u001b[23X\u001b[23Cto send anything. No error, no traffic, no pods.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m So the blast radius of a readiness probe is not one replica.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m It is every replica that shares whatever the probe is asking about.\u001b[32X\u001b[24;103H\u001b[1K\n\u001b[1K\r\n  \u001b[37mThree replicas, probing every two seconds. One and a half scans per second.\u001b[39m\u001b[26X\u001b[27;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n       9 |      1 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[35;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwelve connections out of fifty-seven. I did not even wake up.\u001b[39m\u001b[21X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAll green. Zero incidents.\u001b[39"]
