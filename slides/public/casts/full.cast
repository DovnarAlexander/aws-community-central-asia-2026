[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1m-> step 1.2: The number, and the documentation\u001b(B\u001b[m\u001b[55X\u001b[5;103H\u001b[1K\u001b[35m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[35m\u001b[1m\r\n  1.2 . The number, and the documentation\u001b(B\u001b[m\u001b[62X\u001b[35m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[9;103H\u001b[1K\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mCrashLoop? Seen it a hundred times. One line fixes it.\u001b[39m\u001b[29X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhich one?\u001b[39m\u001b[73X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThe one with the number in it.\u001b[39m\u001b[53X\u001b[13;103H\u001b[1K\r\n  \u001b[1mwhat changes: 10-liveness-naive.yaml -> 11-liveness-initialdelay.yaml\u001b(B\u001b[m\u001b[32X\r\n  \u001b[36m@@ -1,8 +1,16 @@\u001b[39m\u001b[85X\r\n  \u001b[31m-# Incident 1, step 1.1 -- the probe Timur copied out of a blog post.\u001b[39m\u001b[32X\r\n  \u001b[32m+# Incident 1, step 1.2 -- Ruslan fixes production the way Ruslan fixes production.\u001b[39m"]
[0.000, "o", "\u001b[18X\r\n   #\u001b[99X\r\n  \u001b[31m-# The service takes 30 seconds to warm up. The probe starts asking after 5, and\u001b[39m\u001b[21X\r\n  \u001b[31m-# gives up after three misses at 5-second intervals. 5 + 3x5 = 20 seconds of\u001b[39m\u001b[24X\r\n  \u001b[31m-# patience against 30 seconds of startup. Nothing here is a bug, and the pod\u001b[39m\u001b[24X\r\n  \u001b[31m-# dies every single time.\u001b[39m\u001b[75X\r\n  \u001b[32m+# 25 is bigger than 15, the CrashLoop stops, and the fix holds until the day the\u001b[39m\u001b[20X\r\n  \u001b[32m+# service starts taking longer. It is a bet that tomorrow looks like today.\u001b[39m\u001b[25X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# These numbers used to be 40 against 30. They are half that now because the\u001b[39m\u001b[24X\r\n  \u001b[32m+# failure is pure arithmetic -- initialDelay + failureThreshold x period against\u001b[39m\u001b[20X\r\n  \u001b[32m+# the warmup -- and arithmetic is as true at 25 seconds as at 40. What the\u001b[39m\u001b[26X\r\n  \u001b[32m+# halving bought is most of a minute of stage time, which the theory cards now\u001b[39m\u001b[22X\r\n  \u001b[32m+# spend explaining the probe while the rollout settles.\u001b[3"]
[0.000, "o", "9m\u001b[45X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# Green here:  warmup 15 < initialDelay 25, ten seconds of margin.\u001b[39m\u001b[34X\r\n  \u001b[32m+# Broken next: the step sets WARMUP_SECONDS=50 against 25 + 3x5 = 40 seconds of\u001b[39m\u001b[21X\r\n  \u001b[32m+# patience, so the kill lands at 40 and the pod would have been ready at 50.\u001b[39m\u001b[24X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -32,5 +40,5 @@\u001b[39m spec:\u001b[78X\u001b[38;13H\u001b[1K\u001b[Cenv:\u001b[86X\u001b[39;15H\u001b[1K\u001b[C- name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-\u001b[14X\u001b[14Cvalue: \"30\"\u001b[39m\u001b[75X\r\n  \u001b[32m+\u001b[14X\u001b[14Cvalue: \"15\"\u001b[39m\u001b[75X\u001b[42;15H\u001b[1K\u001b[C- name: HEALTHZ_MODE\u001b[68X\u001b[43;17H\u001b[1K\u001b[Cvalue: \"local\"\u001b[72X\r\n  \u001b[36m@@ -44,5 +52,5 @@\u001b[39m\u001b[84X\u001b[?12l\u001b[?25h\u001b[C\u001b[?2026l\u001b[?2026h\r\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2;103H\u001b[1K\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mCrashLoop? Seen it a hundred times. One line fixes it.\u001b[39m\u001b[29X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhich one?\u001b[39m\u001b[73X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThe one with the number in it.\u001b[39m\u001b[53X\u001b[6;103H\u001b[1K\r\n  \u001b[1mwhat changes: 10-liveness-naive.yaml -> 11-liveness-initialdelay.yaml\u001b(B\u001b[m\u001b[32X\r\n  \u001b[36m@@ -1,8 +1,16 @@\u001b[39m\u001b[85X\r\n  \u001b[31m-# Incident 1, step 1.1 -- the probe Timur copied out of a blog post.\u001b[39m\u001b[32X\r\n  \u001b[32m+# Incident 1, step 1.2 -- Ruslan fixes production the way Ruslan fixes production.\u001b[39m\u001b[18X\r\n   #\u001b[99X\r\n  \u001b[31m-# The service takes 30 seconds to warm up. The probe starts asking after 5, and\u001b[39m\u001b[21X\r\n  \u001b[31m-# gives up after three misses at 5-second intervals. 5 + 3x5 = 20 seconds of\u001b[39m\u001b[24X\r\n  \u001b[31m-# patience against 30 seconds of startup. Nothing here is a bug, and the pod\u001b[39m\u001b[24X\r\n  \u001b[31m-# dies every single time.\u001b[39m\u001b[75X\r\n  \u001b[32m+# 25 is bigger than 15, the CrashLoo"]
[0.000, "o", "p stops, and the fix holds until the day the\u001b[39m\u001b[20X\r\n  \u001b[32m+# service starts taking longer. It is a bet that tomorrow looks like today.\u001b[39m\u001b[25X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# These numbers used to be 40 against 30. They are half that now because the\u001b[39m\u001b[24X\r\n  \u001b[32m+# failure is pure arithmetic -- initialDelay + failureThreshold x period against\u001b[39m\u001b[20X\r\n  \u001b[32m+# the warmup -- and arithmetic is as true at 25 seconds as at 40. What the\u001b[39m\u001b[26X\r\n  \u001b[32m+# halving bought is most of a minute of stage time, which the theory cards now\u001b[39m\u001b[22X\r\n  \u001b[32m+# spend explaining the probe while the rollout settles.\u001b[39m\u001b[45X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# Green here:  warmup 15 < initialDelay 25, ten seconds of margin.\u001b[39m\u001b[34X\r\n  \u001b[32m+# Broken next: the step sets WARMUP_SECONDS=50 against 25 + 3x5 = 40 seconds of\u001b[39m\u001b[21X\r\n  \u001b[32m+# patience, so the kill lands at 40 and the pod would have been ready at 50.\u001b[39m\u001b[24X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -32,5 +40,5 @@\u001b[39m sp"]
