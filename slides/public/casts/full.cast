[1.394, "o", "\u001b[?2026h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[2;103H\u001b[1K\r\n  \u001b[37mShe said it out loud three times in the first incident. This time she writes it down.\u001b[39m\u001b[16X\u001b[4;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. HOW A READINESS FAILURE ACTUALLY REMOVES A POD\u001b(B\u001b[m\u001b[32X\r\n  \u001b[2m|\u001b(B\u001b[m The Service does not route to pods. It routes to an EndpointSlice,\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m and readiness is what puts an address in it or takes it out.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m One pod NotReady   -> its address is removed, the rest carry the load.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m Every pod NotReady -> the slice is empty and the Service has nowhere\u001b[31X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[23X\u001b[23Cto send anything. No error, no traffic, no pods.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m So the blast radius of a readiness probe is not one replica.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m It is every replica that shares whatever the probe is asking about.\u001b[32X\u001b[15;103H\u001b[1K\n\u001b[1K\r\n  \u001b[37mThree replicas, probing every two seconds. One and a half scans per second.\u001b[39m\u001b[26X\u001b[18;103H\u001b[1K\r"]
[0.000, "o", "\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n      17 |      7 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[26;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwelve connections out of fifty-four. I did not even wake up.\u001b[39m\u001b[22X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAll green. Zero incidents.\u001b[39m\u001b[57X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhile there are three replicas, yes.\u001b[39m\u001b[47X\u001b[30;103H\u001b[1K\r\n  \u001b[1m-> step 2.2: Black Friday: the queue fills\u001b(B\u001b[m\u001b[59X\u001b[32;103H\u001b[1K\u001b[35m\u001b[1m\r\n=======================================================================================================\u001b(B\u001b[m\u001b[35m\u001b[1m\r\n  2.2 . Black Friday: the queue fills\u001b(B\u001b[m\u001b[66X\u001b[35m\u001b[1m\r\n=="]
[0.000, "o", "=====================================================================================================\u001b(B\u001b[m\u001b[36;103H\u001b[1K\r\n  \u001b[37mBlack Friday. The work arrives as a queue, which is what the whole system was built for.\u001b[39m\u001b[13X\u001b[38;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo get scaledobject worker -o\u001b(B\u001b[m\u001b[57X\r\n    \u001b[36m\u001b[1mcustom-columns='NAME:.metadata.name,MIN:.spec.minReplicaCount,MAX:.spec.maxReplicaCount,TRIGGER:.sp\u001b(B\u001b[m\u001b[36m\u001b[1m\r\nec.triggers[*].type'\u001b(B\u001b[m\u001b[83X\r\n  NAME     MIN   MAX   TRIGGER\u001b[73X\r\n  worker   0     24    aws-sqs-queue\u001b[67X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
[0.004, "o", "\u001b[?2026h\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[37mShe said it out loud three times in the first incident. This time she writes it down.\u001b[39m\u001b[16X\u001b[3;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. HOW A READINESS FAILURE ACTUALLY REMOVES A POD\u001b(B\u001b[m\u001b[32X\r\n  \u001b[2m|\u001b(B\u001b[m The Service does not route to pods. It routes to an EndpointSlice,\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m and readiness is what puts an address in it or takes it out.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m One pod NotReady   -> its address is removed, the rest carry the load.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m Every pod NotReady -> the slice is empty and the Service has nowhere\u001b[31X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[23X\u001b[23Cto send anything. No error, no traffic, no pods.\u001b[29X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m So the blast radius of a readiness probe is not one replica.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m It is every replica that shares whatever the probe is asking about.\u001b[32X\u001b[14;103H\u001b[1K\n\u001b[1K\r\n  \u001b[37mThree replicas, probing every two seconds. One and a half scans per second.\u001b[39m\u001b[26X\u001b[17;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec"]
