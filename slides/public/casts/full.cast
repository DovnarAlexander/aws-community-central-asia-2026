[0.011, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[38;5;45m──\u001b[101C┬\u001b(B\u001b[m\u001b[38;5;238m──\u001b[2;104H\u001b(B\u001b[m\u001b[38;5;45m│\u001b[3;104H│\u001b[4;104H│\u001b[5;104H│\u001b[6;104H│\u001b[7;104H│\u001b[8;104H│\u001b[9;104H│\u001b[10;104H│\u001b[11;104H│\u001b[12;104H│\u001b[13;104H│\u001b[14;104H│\u001b[15;104H│\u001b[16;104H│\u001b[17;104H│\u001b[18;104H│\u001b[19;104H│\u001b[20;104H│\u001b[21;104H│\u001b[22;104H│\u001b[23;104H│\u001b[24;104H│\u001b[25;104H│\u001b[26;104H│\u001b[27;104H├\u001b(B\u001b[m\u001b[38;5;238m──\u001b[28;104H\u001b(B\u001b[m\u001b[38;5;45m│\u001b[29;104H│\u001b[30;104H│\u001b[31;104H│\u001b[32;104H│\u001b[33;104H├\u001b(B\u001b[m\u001b[38;5;238m──\u001b[34;104H\u001b(B\u001b[m\u001b[38;5;45m│\u001b[35;104H│\u001b[36;104H│\u001b[37;104H│\u001b[38;104H│\u001b[39;104H│\u001b[40;104H│\u001b[41;104H│\u001b[42;104H│\u001b[43;104H│\u001b[44;104H│\u001b(B\u001b[m\u001b[38;5;45m\u001b[1;3H DEMO . step 1.1 . Timur ships a service ────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[38;5;238m\u001b[3C PODS ─────────────────────────────"]
[0.000, "o", "──────────────────────────\u001b(B\u001b[m\u001b[38;5;238m\u001b[27;107H LOAD ───────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[38;5;238m\u001b[33;107H LOAD ───────────────────────────────────────────────────────\u001b[1;1H\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[44d\u001b[?2026l"]
