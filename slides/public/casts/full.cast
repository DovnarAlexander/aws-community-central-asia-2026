[0.000, "o", "\u001b(B\u001b[m \u001b[37mThat is a health check multiplied by the replica count.\u001b[39m\u001b[28X\u001b[28;103H\u001b[1K\r\n  \u001b[37mAt three replicas it was a third of a core. KEDA is allowed twenty-four.\u001b[39m\u001b[29X\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwenty-four workers at four connections is ninety-six. I have fifty-four.\u001b[39m\u001b[10X\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd two vCPU, which are now entirely yours.\u001b[39m\u001b[40X\u001b[32;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT state, count(*),\u001b(B\u001b[m\u001b[10X\r\n    \u001b[36m\u001b[1mmax(now()-query_start)::interval(0) AS longest FROM pg_stat_activity WHERE\u001b(B\u001b[m\u001b[25X\r\n    \u001b[36m\u001b[1mdatname=current_database() GROUP BY state ORDER BY 2 DESC\\\"\"\u001b(B\u001b[m\u001b[39X\r\n  psql: error: connection to server at \"probes-demo.xxxxxxxxxxxx.eu-central-1.rds.amazonaws.com\" (10.42\r\n.24.19), port 5432 failed: FATAL:  remaining connection slots are reserved for roles with privileges of\r\n the \"rds_reserved\" role\u001b[79X\r\n  command terminated with exit code 2\u001b[66X\r\n  "]
[0.000, "o", "\u001b[33m\u001b[1m-> exit 2\u001b(B\u001b[m\u001b[92X\u001b[41;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo logs -l app=worker --tail=3 --prefix 2>/dev/null | grep -i 'too many\\|pool\u001b(B\u001b[m         \r\n    \u001b[36m\u001b[1mat\\|process:' | tail -8\u001b(B\u001b[m\u001b[76X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
