[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  worker-6c7455ddf-kzzg5         \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  ContainerCreating R:0\u001b[44X\r\n  worker-6c7455ddf-nq6x5         \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-6c7455ddf-ps9q6         \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-6c7455ddf-qxdq6         \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-2cwsh        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-dz2x8        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-fkbh4        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-gz9k9        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-h4k7w        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-qzq6r        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7dc9f7b67d-rjvrt        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\u001b[13;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo dep"]
[0.000, "o", "loy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n      26 |     16 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[21;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mForty-five connections, almost nothing active. Carry on.\u001b[39m\u001b[27X\r\n  \u001b[2m# load stopped\u001b(B\u001b[m\u001b[87X\r\n  \u001b[33m\u001b[1mno data to compare (incident2-before / incident2-after)\u001b(B\u001b[m\u001b[46X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mSame load. Same scale target.\u001b[39m\u001b[54X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mDifferent probe.\u001b[39m\u001b[67X\u001b[27;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwelve workers. Twelve Ready. A minute ago there were twenty-four and next to\u001b[39m      \r\n        \u001b[37mnone of them served.\u001b[39m\u001b[75X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b"]
[0.000, "o", "(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mSo we are still behind.\u001b[39m\u001b[60X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mBehind, and working. Those twenty-four took messages and handed every one of\u001b[39m       \r\n        \u001b[37mthem back.\u001b[39m\u001b[85X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThese twelve finish what they take. One probe changed. Nothing else did.\u001b[39m\u001b[11X\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mNothing is Pending. I have stopped buying.\u001b[39m\u001b[41X\r\n  \u001b[37mAnd nothing new was bought. Karpenter gives the idle machines back a couple of minutes later. It\u001b[39m     \r\n  \u001b[37mwas never the problem -- it did what it was asked.\u001b[39m\u001b[51X\u001b[37;103H\u001b[1K\u001b[32m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[32m\u001b[1m\r\n  readiness = can THIS pod serve, not is the shared database alive.\u001b(B\u001b[m\u001b[36X\u001b[32m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[41;103H\u001b[1K\n\u001b[1K\r\n  \u001b[1mPOS"]
