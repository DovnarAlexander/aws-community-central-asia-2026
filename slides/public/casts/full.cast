[0.000, "o", " I have fifty-four.\u001b[39m\u001b[10X\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd two vCPU, which are now entirely yours.\u001b[39m\u001b[40X\u001b[41;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT state, count(*),\u001b(B\u001b[m\u001b[10X\r\n    \u001b[36m\u001b[1mmax(now()-query_start)::interval(0) AS longest FROM pg_stat_activity WHERE\u001b(B\u001b[m\u001b[25X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l\u001b[?2026h\u001b[?2026l"]
