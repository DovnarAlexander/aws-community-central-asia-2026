[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[37mThree replicas, probing every two seconds. One and a half scans per second.\u001b[39m\u001b[26X\u001b[3;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n      17 |      7 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[11;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwelve connections out of fifty-four. I did not even wake up.\u001b[39m\u001b[22X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAll green. Zero incidents.\u001b[39m\u001b[57X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mWhile there are three replicas, yes.\u001b[39m\u001b[47X\u001b[15;103H\u001b[1K\r\n  \u001b[1m-> step 2.2: Black Friday: the queue fills\u001b(B\u001b[m\u001b[59X\u001b[17;103H\u001b[1K\u001b[35m\u001b[1m\r\n=========================================================="]
[0.000, "o", "=============================================\u001b(B\u001b[m\u001b[35m\u001b[1m\r\n  2.2 . Black Friday: the queue fills\u001b(B\u001b[m\u001b[66X\u001b[35m\u001b[1m\r\n=======================================================================================================\u001b(B\u001b[m\u001b[21;103H\u001b[1K\r\n  \u001b[37mBlack Friday. The work arrives as a queue, which is what the whole system was built for.\u001b[39m\u001b[13X\u001b[23;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo get scaledobject worker -o\u001b(B\u001b[m\u001b[57X\r\n    \u001b[36m\u001b[1mcustom-columns='NAME:.metadata.name,MIN:.spec.minReplicaCount,MAX:.spec.maxReplicaCount,TRIGGER:.sp\u001b(B\u001b[m\u001b[36m\u001b[1m\r\nec.triggers[*].type'\u001b(B\u001b[m\u001b[83X\r\n  NAME     MIN   MAX   TRIGGER\u001b[73X\r\n  worker   0     24    aws-sqs-queue\u001b[67X\u001b[29;103H\u001b[1K\r\n  \u001b[37mKEDA watches the queue. Zero workers right now, because there is nothing to do.\u001b[39m\u001b[22X\u001b[31;103H\u001b[1K\r\n  \u001b[32m\u001b[1mload starts\u001b(B\u001b[m  \u001b[1mincident2-before\u001b(B\u001b[m \u001b[2m. enqueue . 20 rps for 90s\u001b(B\u001b[m\u001b[45X\r\n  \u001b[2mwatch the LOAD panel, bottom right\u001b(B\u001b[m\u001b[67X\r\n  \u001b[37mFilling the queue: two thousand messages a second going in.\u001b[39m\u001b"]
[0.000, "o", "[42X\u001b[35;103H\u001b[1K\r\n  \u001b[1mKEDA, AND WHAT IT IS COUNTING\u001b(B\u001b[m\u001b[72X\r\n  \u001b[2m|\u001b(B\u001b[m pollingInterval 5   it asks SQS how deep the queue is\u001b[46X\r\n  \u001b[2m|\u001b(B\u001b[m queueLength 20      messages per worker it is willing to tolerate\u001b[34X\r\n  \u001b[2m|\u001b(B\u001b[m maxReplicaCount 24  the ceiling, and the only thing stopping it\u001b[36X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m desired workers = queue depth / 20, capped at 24.\u001b[50X\r\n  \u001b[2m|\u001b(B\u001b[m minReplicaCount is 0, so this scales up from nothing at all.\u001b[39X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
[0.118, "o", "\u001b[?2026h\u001b[3;141H\u001b[38;5;230m\u001b[40m\u001b[1m6\u001b[6;107H\u001b(B\u001b[m\u001b[38;5;117m\u001b[40mloadgen                  \u001b[C●\u001b[2C1/1  \u001b[CRunning   \u001b[8C0\u001b[C10.4\u001b[7;107H\u001b(B\u001b[m\u001b[38;5;102m\u001b[40mseed-p8bzx               \u001b[C●\u001b[2C0/1  \u001b[CCompleted \u001b[8C0\u001b[C10.4\u001b[8;122H\u001b(B\u001b[m\u001b[38;5;117m\u001b[40mn\u001b[Ct69\u001b[9;123H8wlw\u001b[10;107Hsvc-7bc999ffc5-wrp7d     \u001b(B\u001b[m\u001b[38;5;73m\u001b[40m \u001b(B\u001b[m\u001b[38;5;117m\u001b[40m●\u001b[C\u001b(B\u001b[m\u001b[38;5;73m\u001b[40m \u001b(B\u001b[m\u001b[38;5;117m\u001b[40m1/1  \u001b(B\u001b[m\u001b[38;5;73m\u001b[40m \u001b(B\u001b[m\u001b[38;5;117m\u001b[40mRunning   \u001b(B\u001b[m\u001b[38;5;73m\u001b[40m \u001b[7C\u001b(B\u001b[m\u001b[38;5;117m\u001b[40m0\u001b(B\u001b[m\u001b[38;5;73m\u001b[40m \u001b(B\u001b[m\u001b[38;5;117m\u001b[40m10.4\u001b[44;1H\u001b(B\u001b[m\u001b[?2026l"]
