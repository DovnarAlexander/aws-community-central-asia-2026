[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2;103H\u001b[1K\r\n  \u001b[31m\u001b[1m[>_<] KEDA     \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mQueue is deep. Adding workers.\u001b[39m\u001b[53X\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mPods are Pending. Buying machines.\u001b[39m\u001b[49X\u001b[5;103H\u001b[1K\r\n  \u001b[2mqueue depth up, workers up, nodes up\u001b(B\u001b[m\u001b[65X\r\n  \u001b[2mqueue \u001b(B\u001b[m\u001b[1m0/0\u001b(B\u001b[m\u001b[2m . workers \u001b(B\u001b[m\u001b[1m0/0\u001b(B\u001b[m\u001b[2m . nodes \u001b(B\u001b[m\u001b[1m1\u001b(B\u001b[m\u001b[2m ~$0.02/h . 80s . [->] click to move on\u001b(B\u001b[m\u001b[29X\u001b[8;103H\u001b[1K\n\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl get nodes -l role=demo\u001b(B\u001b[m\u001b[69X\r\n  NAME\u001b[44X\u001b[44CSTATUS   ROLES    AGE     VERSION\u001b[20X\r\n  ip-10-42-17-219.eu-central-1.compute.internal   Ready    <none>   8m31s   v1.34.10-eks-cb19647       \r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThis is the system working. Look at it scale.\u001b[39m\u001b[38X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mLook at what each new worker does before it processes anything.\u001b[39m\u001b[20X\u001b[15;103H\u001b[1K\r\n  \u001b[1m-> step 2.3: The cascade, and the autoscalers help\u001b(B\u001b[m\u001b[51X\u001b[17;103H\u001b[1K\u001b[35m\u001b[1m\r\n===================="]
[0.000, "o", "================================================================================\u001b(B\u001b[m   \u001b[35m\u001b[1m\r\n  2.3 . The cascade, and the autoscalers help\u001b(B\u001b[m\u001b[58X\u001b[35m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m   \u001b[21;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mEvery replica opens its own pool. Four connections each.\u001b[39m\u001b[27X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd every replica scans two million rows every two seconds, because that is what\u001b[39m   \r\n        \u001b[37mits readiness probe does.\u001b[39m\u001b[70X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThat is a health check.\u001b[39m\u001b[60X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThat is a health check multiplied by the replica count.\u001b[39m\u001b[28X\u001b[27;103H\u001b[1K\r\n  \u001b[37mAt three replicas it was a third of a core. KEDA is allowed twenty-four.\u001b[39m\u001b[29X\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwenty-four workers at four connections is ninety-six. I have fifty-s"]
[0.000, "o", "even.\u001b[39m         \r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd two vCPU, which are now entirely yours.\u001b[39m\u001b[40X\u001b[31;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT state, count(*),\u001b(B\u001b[m\u001b[10X\r\n    \u001b[36m\u001b[1mmax(now()-query_start)::interval(0) AS longest FROM pg_stat_activity WHERE\u001b(B\u001b[m\u001b[25X\r\n    \u001b[36m\u001b[1mdatname=current_database() GROUP BY state ORDER BY 2 DESC\\\"\"\u001b(B\u001b[m\u001b[39X\r\n   state  | count | longest\u001b[76X\r\n  --------+-------+----------\u001b[74X\r\n   idle   |     8 | 00:00:23\u001b[75X\r\n   active |     1 | 00:00:00\u001b[75X\r\n  (2 rows)\u001b[93X\u001b[40;103H\u001b[1K\n\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo logs -l app=worker --tail=3 --prefix 2>/dev/null | grep -i 'too many\\|pool\u001b(B\u001b[m         \r\n    \u001b[36m\u001b[1mat\\|process:' | tail -8\u001b(B\u001b[m\u001b[76X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
