[0.000, "o", " active |     1 | 00:00:00\u001b[75X\r\n  (2 rows)\u001b[93X\u001b[30;103H\u001b[1K\n\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo logs -l app=worker --tail=3 --prefix 2>/dev/null | grep -i 'too many\\|pool\u001b(B\u001b[m         \r\n    \u001b[36m\u001b[1mat\\|process:' | tail -8\u001b(B\u001b[m\u001b[76X\r\n  \u001b[33m\u001b[1m-> exit 1\u001b(B\u001b[m\u001b[92X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37m\"too many connections\". The pods are up and they are not Ready.\u001b[39m\u001b[20X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd a worker that cannot reach the database does not delete its message.\u001b[39m\u001b[11X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThe message comes back. The queue gets deeper.\u001b[39m\u001b[37X\r\n  \u001b[31m\u001b[1m[>_<] KEDA     \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mQueue is deeper. Adding workers.\u001b[39m\u001b[51X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mThat is the loop.\u001b[39m\u001b[66X\u001b[40;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. THE LOOP\u001b(B\u001b[m\u001b[70X\r\n  \u001b[2m|\u001b(B\u001b[m probe asks the DB  ->  replicas NotReady  ->  workers stop consuming\u001b[31X\r\n  \u001b[2m|\u001b(B\u001b[m   ^\u001b[53X\u001b[53C|\u001b[42X\u001b[44;103H\u001b[1K\u001b"]
