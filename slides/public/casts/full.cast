[0.069, "o", "\u001b[?2026h\u001b[2;44r\u001b[39;103H\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\n\u001b[1K\u001b[6A\u001b[1K\r  \u001b[2mthroughput at zero, nodes still climbing\r\n\u001b(B\u001b[m  \u001b[2mqueue \u001b(B\u001b[m\u001b[1m0/0\u001b(B\u001b[m\u001b[2m . workers \u001b(B\u001b[m\u001b[1m0/4\u001b(B\u001b[m\u001b[2m . nodes \u001b(B\u001b[m\u001b[1m1\u001b(B\u001b[m\u001b[2m ~$0.02/h . 115s . [->] click to move on\r\n\u001b(B\u001b[m  worker-7dc9f7b67d-2cwsh        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  ContainerCreating R:0\r\n  worker-7dc9f7b67d-fkbh4        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  Running          R:0\r\n  worker-7dc9f7b67d-gz9k9        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  Running          R:0\r\n  worker-7dc9f7b67d-qzq6r        \u001b[31m\u001b[1m0/1\u001b(B\u001b[m  Running          R:0\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
