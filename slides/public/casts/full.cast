[0.000, "o", "eing busy.\u001b[39m\u001b[51X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[21S\u001b[2;44r\u001b[s\u001b[23;1H  \u001b[32m+# And the numbers get slack: 10-second period, 3-second timeout, five misses.\r\n\u001b[39m  \u001b[32m+# A liveness probe should be the last resort, not the first responder -- taking\u001b[39m\u001b[21X\r\n  \u001b[32m+# a busy replica out of the load balancer is readiness' job, and readiness stays\u001b[39m\u001b[20X\r\n  \u001b[32m+# tight on purpose.\u001b[39m\u001b[81X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -41,5 +41,5 @@\u001b[39m spec:\u001b[78X\r\n                 value: \"4\"\u001b[76X\r\n               - name: HEALTHZ_MODE\u001b[68X\r\n  \u001b[31m-              value: \"db\"\u001b[39m\u001b[75X\r\n  \u001b[32m+              value: \"local\"\u001b[39m\u001b[72X\r\n               - name: READY_MODE\u001b[70X\r\n                 value: \"cached\"\u001b[71X\r\n  \u001b[36m@@ -56,7 +56,7 @@\u001b[39m spec:\u001b[78X\r\n             livenessProbe:\u001b[76X\r\n               httpGet: { path: /healthz, port: 8080 }\u001b[49X\r\n  \u001b[31m-            periodSeconds: 5\u001b[39m\u001b[72X\r\n  \u001b[31m-            timeoutSeconds: 1\u001b[39m\u001b[71X\r\n  "]
[0.000, "o", "\u001b[31m-            failureThreshold: 3\u001b[39m\u001b[69X\r\n  \u001b[32m+            periodSeconds: 10\u001b[39m\u001b[71X\r\n  \u001b[32m+            timeoutSeconds: 3\u001b[39m\u001b[71X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[3S\u001b[2;44r\u001b[s\u001b[41;1H  \u001b[32m+            failureThreshold: 5\r\n\u001b[39m             readinessProbe:\u001b[75X\r\n               httpGet: { path: /ready, port: 8080 }\u001b[51X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
