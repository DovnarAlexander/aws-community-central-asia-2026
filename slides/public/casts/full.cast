[0.023, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[12S\u001b[2;44r\u001b[s\u001b[32;1H  \u001b[36m@@ -1,16 +1,14 @@\r\n\u001b[39m  \u001b[31m-# Incident 1, step 1.2 -- Ruslan fixes production the way Ruslan fixes production.\u001b[39m\u001b[18X\r\n  \u001b[32m+# Incident 1, step 1.2, second half -- Madina read the documentation.\u001b[39m\u001b[31X\r\n   #\u001b[99X\r\n  \u001b[31m-# 25 is bigger than 15, the CrashLoop stops, and the fix holds until the day the\u001b[39m\u001b[20X\r\n  \u001b[31m-# service starts taking longer. It is a bet that tomorrow looks like today.\u001b[39m\u001b[25X\r\n  \u001b[32m+# startupProbe gives the slow start its own budget: 60 checks at 2 seconds is\u001b[39m\u001b[23X\r\n  \u001b[32m+# two minutes of patience, and while it runs, liveness is not consulted at all.\u001b[39m\u001b[21X\r\n  \u001b[32m+# The liveness numbers can then be about steady-state health, which is the only\u001b[39m\u001b[21X\r\n  \u001b[32m+# thing they were ever meant to be about.\u001b[39m\u001b[59X\r\n   #\u001b[99X\r\n  \u001b[31m-# These numbers used to be 40 against 30. They are half that now because the\u001b[39m\u001b[24X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[12S\u001b[2;44r\u001b[s\u001b[32;1H  \u001b[31m-# failure is pure arithmetic -- initialDelay + failureThreshold x period against\r\n\u001b[39m  \u001b[31m-# the warmup -- and arithmetic is as true at 25 seconds as at 40. What the\u001b[39m\u001b[26X\r\n  \u001b[31m-# halving bought is most of a minute of stage time, which the theory cards now\u001b[39m\u001b[22X\r\n  \u001b[31m-# spend explaining the probe while the rollout settles.\u001b[39m\u001b[45X\r\n  \u001b[31m-#\u001b[39m\u001b[99X\r\n  \u001b[31m-# Green here:  warmup 15 < initialDelay 25, ten seconds of margin.\u001b[39m\u001b[34X\r\n  \u001b[31m-# Broken next: the step sets WARMUP_SECONDS=50 against 25 + 3x5 = 40 seconds of\u001b[39m\u001b[21X\r\n  \u001b[31m-# patience, so the kill lands at 40 and the pod would have been ready at 50.\u001b[39m\u001b[24X\r\n  \u001b[32m+# WARMUP_SECONDS is 50 rather than 15 on purpose, and it has to match the value\u001b[39m\u001b[21X\r\n  \u001b[32m+# the previous step broke the service with: the point of this step is that the\u001b[39m\u001b[22X\r\n  \u001b[32m+# same slow start that was being punished a minute ago is now simply waited for.\u001b[39m\u001b[20X\r\n  \u001b[3"]
[0.000, "o", "2m+# It used to say 30 here while the script claimed 60 out loud, which made the\u001b[39m\u001b[23X\r\n  \u001b[32m+\u001b[39m\u001b[100X\u001b[1;44r\u001b[44;4H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[23S\u001b[2;44r\u001b[s\u001b[21;4H\u001b[32m# apply quietly undo the breakage the step was built on.\r\n\u001b[39m   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -40,5 +38,5 @@\u001b[39m spec:\u001b[78X\r\n             env:\u001b[86X\r\n               - name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-              value: \"15\"\u001b[39m\u001b[75X\r\n  \u001b[32m+              value: \"50\"\u001b[39m\u001b[75X\r\n               - name: HEALTHZ_MODE\u001b[68X\r\n                 value: \"local\"\u001b[72X\r\n  \u001b[36m@@ -50,7 +48,11 @@\u001b[39m spec:\u001b[77X\r\n             resources:\u001b[80X\r\n               requests: { cpu: \"250m\", memory: \"64Mi\" }\u001b[47X\r\n  \u001b[32m+          startupProbe:\u001b[39m\u001b[77X\r\n  \u001b[32m+            httpGet: { path: /startupz, port: 8080 }\u001b[39m\u001b[48X\r\n  \u001b[32m+            periodSeconds: 2\u001b[39m\u001b[72X\r\n  \u001b[32m+            timeoutSeconds: 1\u001b[39m\u001b[71X\r\n  \u001b[32m+            failureThreshold: 60\u001b[39m\u001b[68X\r\n             livenessProbe:\u001b[7"]
[0.001, "o", "6X\r\n               httpGet: { path: /healthz, port: 8080 }\u001b[49X\r\n  \u001b[31m-            initialDelaySeconds: 25\u001b[39m\u001b[65X\r\n               periodSeconds: 5\u001b[72X\r\n               timeoutSeconds: 1\u001b[71X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
