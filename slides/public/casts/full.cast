[0.000, "o", "██████████████████████\u001b(B\u001b[m\u001b[2m░░░░░\u001b(B\u001b[m  \u001b[2mlet it run . [->] skips\u001b(B\u001b[m\u001b[18X\r\n  worker-7b7c9b974c-7zhw9        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-8nrpn        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-8x44g        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-jmm79        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-jv6bx        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-l9qw7        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-m542v        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-nbmmc        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-nps5v        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-pbx28        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worker-7b7c9b974c-qrt6b        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  worke"]
[0.000, "o", "r-7b7c9b974c-rldlg        \u001b[32m\u001b[1m1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\u001b[28;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT count(*) AS conns,\u001b(B\u001b[m        \r\n    \u001b[36m\u001b[1mcount(*) FILTER (WHERE state='active') AS active, current_setting('max_connections') AS max FROM\u001b(B\u001b[m   \r\n    \u001b[36m\u001b[1mpg_stat_activity WHERE datname=current_database()\\\"\"\u001b(B\u001b[m\u001b[47X\r\n   conns | active | max\u001b[80X\r\n  -------+--------+-----\u001b[79X\r\n      46 |     24 | 60\u001b[81X\r\n  (1 row)\u001b[94X\u001b[36;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mForty-five connections, almost nothing active. Carry on.\u001b[39m\u001b[27X\u001b[38;103H\u001b[1K\r\n  \u001b[33m\u001b[1mload stops\u001b(B\u001b[m   \u001b[1mincident2-after\u001b(B\u001b[m \u001b[2m. the panel keeps the summary\u001b(B\u001b[m\u001b[43X\u001b[40;103H\u001b[1K\u001b[1m\r\n-------------------------------------------------------------------------------------------------------\u001b(B\u001b[m\u001b[1m\r\n  INCIDENT 2 . same queue, before and after unhooking the probe\u001b(B\u001b[m\u001b[40X\u001b[1m\r\n--------------------------------------------------------"]
