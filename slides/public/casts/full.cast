[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[2m|\u001b(B\u001b[m initialDelaySeconds   5   wait this long before the first question\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m periodSeconds         5   then ask again this often\u001b[48X\r\n  \u001b[2m|\u001b(B\u001b[m timeoutSeconds        1   an answer slower than this is a miss\u001b[37X\r\n  \u001b[2m|\u001b(B\u001b[m failureThreshold      3   this many misses in a row and the pod dies\u001b[31X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m Patience = initialDelay + failureThreshold x period = 20 seconds.\u001b[34X\r\n  \u001b[2m|\u001b(B\u001b[m The service needs 30. Nothing else here is a bug.\u001b[50X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m kubelet asks. Not a load balancer, not a human, not your code.\u001b[37X\u001b[11;103H\u001b[1K\n\u001b[1K\r\n  \u001b[2mPending -- waiting on EC2\u001b(B\u001b[m\u001b[76X\r\n  \u001b[2mready \u001b(B\u001b[m\u001b[1m0/1\u001b(B\u001b[m\u001b[2m . restarts \u001b(B\u001b[m\u001b[1m0\u001b(B\u001b[m\u001b[2m . nodes \u001b(B\u001b[m\u001b[1m1\u001b(B\u001b[m\u001b[2m . 2s . [->] click to move on\u001b(B\u001b[m\u001b[40X\r\n  svc-74878fb98c-kmwxf\u001b[11X\u001b[31m\u001b[1m\u001b[11C0/1\u001b(B\u001b[m  \u001b[33m\u001b[1mPending\u001b(B\u001b[m\u001b[10X\u001b[10CR:0\u001b[45X\r\n  \u001b[32m\u001b[1m+ node arrived, pod scheduled (2s)\u001b(B\u001b[m\u001b[67X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m "]
[0.000, "o", "\u001b[37mFive seconds gone. Asking: are you alive?\u001b[39m\u001b[42X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mIt is warming up.\u001b[39m\u001b[66X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m \u001b[37mThat answer is not in the manifest.\u001b[39m\u001b[48X\u001b[20;103H\u001b[1K\r\n  \u001b[37mThe warmup runs 30 seconds. The first knock lands at five. Count along.\u001b[39m\u001b[30X\u001b[22;103H\u001b[1K\r\n  \u001b[2mwatch the RESTARTS column\u001b(B\u001b[m\u001b[76X\r\n  \u001b[2mready \u001b(B\u001b[m\u001b[1m1/1\u001b(B\u001b[m\u001b[2m . restarts \u001b(B\u001b[m\u001b[1m2\u001b(B\u001b[m\u001b[2m . nodes \u001b(B\u001b[m\u001b[1m1\u001b(B\u001b[m\u001b[2m . 14s . [->] click to move on\u001b(B\u001b[m\u001b[39X\r\n  svc-74878fb98c-kmwxf\u001b[11X\u001b[32m\u001b[1m\u001b[11C1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:2\u001b[45X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m \u001b[37mThree misses in a row. Killing it.\u001b[39m\u001b[49X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mI did not write a single bug!\u001b[39m\u001b[54X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m \u001b[37mI do not read your code. I read your manifest.\u001b[39m\u001b[37X\u001b[29;103H\u001b[1K\u001b[31m\u001b[1m\r\n====================================================================================================\u001b(B\u001b[m  "]
