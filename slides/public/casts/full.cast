[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[32m+\u001b[12X\u001b[12CfailureThreshold: 3\u001b[39m\u001b[69X\u001b[3;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ envsubst < k8s/incident1/13-under-load.yaml | kubectl apply -f -\u001b(B\u001b[m\u001b[35X\r\n  deployment.apps/svc configured\u001b[71X\r\n  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mBefore it ships. These two are not the same question.\u001b[39m\u001b[30X\r\n  \u001b[33m\u001b[1m(-_-) Ruslan   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mIt is green, Madina.\u001b[39m\u001b[63X\u001b[8;103H\u001b[1K\r\n  \u001b[32m\u001b[1m(^_^) Madina's notes\u001b(B\u001b[m \u001b[1m. RESTART OR REMOVE: TWO VERY DIFFERENT ANSWERS\u001b(B\u001b[m\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m liveness fails   -> kubelet kills the container. Work in flight dies,\u001b[30X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[21X\u001b[21Cthe pool is rebuilt, the cache is cold again.\u001b[34X\r\n  \u001b[2m|\u001b(B\u001b[m readiness fails  -> the pod leaves the EndpointSlice. That is all.\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[21X\u001b[21CIt keeps running, and it comes back by itself.\u001b[33X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m A busy pod is not a dead pod. Slow is a readiness question.\u001b[40X\r\n  \u001b[2m|\u001b(B\u001b[m Liveness has one job: notice a process that will never recover"]
[0.000, "o", ".\u001b[36X\r\n  \u001b[2m|\u001b(B\u001b[m\u001b[100X\r\n  \u001b[2m|\u001b(B\u001b[m Which makes timeoutSeconds: 1 on liveness a latency alarm wired\u001b[36X\r\n  \u001b[2m|\u001b(B\u001b[m to a kill switch.\u001b[82X\u001b[20;103H\u001b[1K\n\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo get pods -l app=svc -o\u001b(B\u001b[m\u001b[61X\r\n    \u001b[36m\u001b[1mcustom-columns='NAME:.metadata.name,READY:.status.containerStatuses[*].ready,STATUS:.status.phase,N\u001b(B\u001b[m\u001b[36m\u001b[1m\r\nODE:.spec.nodeName'\u001b(B\u001b[m\u001b[84X\r\n  NAME\u001b[18X\u001b[18CREADY   STATUS    NODE\u001b[57X\r\n  svc-df868796d-ks6s8   true    Running   ip-10-42-28-217.eu-central-1.compute.internal\u001b[16X\r\n  svc-df868796d-mz2bt   true    Running   ip-10-42-28-217.eu-central-1.compute.internal\u001b[16X\r\n  svc-df868796d-sbt9j   true    Running   ip-10-42-28-217.eu-central-1.compute.internal\u001b[16X\u001b[29;103H\u001b[1K\r\n  \u001b[1mHere comes traffic. The service is healthy. It is simply busy.\u001b(B\u001b[m\u001b[39X\u001b[31;103H\u001b[1K\r\n  \u001b[32m\u001b[1mload starts\u001b(B\u001b[m  \u001b[1mincident1-before\u001b(B\u001b[m \u001b[2m. http . 300 rps for 45s\u001b(B\u001b[m\u001b[47X\r\n  \u001b[2mwatch the LOAD panel, bottom right\u001b(B\u001b[m\u001b[67X\r\n  \u001b[37mThe pool is full of real work, and /he"]
[0.000, "o", "althz joins the same queue.\u001b[39m\u001b[36X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m \u001b[37mA second gone, no answer. Again. And again.\u001b[39m\u001b[40X\r\n  \u001b[37m[o_o] kubelet\u001b[39m   \u001b[2m>\u001b(B\u001b[m \u001b[37mThree misses. Killing it.\u001b[39m\u001b[58X\u001b[37;103H\u001b[1K\r\n  \u001b[2mliveness cannot meet timeoutSeconds: 1\u001b(B\u001b[m\u001b[63X\r\n  \u001b[2mready \u001b(B\u001b[m\u001b[1m3/3\u001b(B\u001b[m\u001b[2m . restarts \u001b(B\u001b[m\u001b[1m0\u001b(B\u001b[m\u001b[2m . nodes \u001b(B\u001b[m\u001b[1m1\u001b(B\u001b[m\u001b[69X\r\n  \u001b[1m 45s\u001b(B\u001b[m  \u001b[2m░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░\u001b(B\u001b[m  \u001b[2mlet it run . [->] skips\u001b(B\u001b[m\u001b[18X\r\n  svc-df868796d-ks6s8\u001b[12X\u001b[32m\u001b[1m\u001b[12C1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  svc-df868796d-mz2bt\u001b[12X\u001b[32m\u001b[1m\u001b[12C1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\r\n  svc-df868796d-sbt9j\u001b[12X\u001b[32m\u001b[1m\u001b[12C1/1\u001b(B\u001b[m  Running\u001b[10X\u001b[10CR:0\u001b[45X\u001b[44;103H\u001b[1K\u001b[?12l\u001b[?25h\r\u001b[?2026l"]
