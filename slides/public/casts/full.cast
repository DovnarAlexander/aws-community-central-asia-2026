[0.016, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mIt holds because nothing changed. Not because the number is right.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mA cold cache. A noisier neighbour on the node. A bigger dataset. One more step\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H        \u001b[37mat boot.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mNone of those touch the manifest, and every one of them moves the start.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mEvery other number in a probe reacts to something the process did. This one only\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H        \u001b[37mcounts.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mIt cannot tell a slow start from a dead process, because it is not looking.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
