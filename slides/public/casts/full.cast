[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[32m\u001b[1m(^_^) Madina\u001b(B\u001b[m \u001b[2m. intern\u001b(B\u001b[m\u001b[80X\r\n        \u001b[37m\"I read the documentation.\"\u001b[39m\u001b[68X\r\n        \u001b[37mNobody asks her opinion for a while.\u001b[39m\u001b[59X\u001b[5;103H\u001b[1K\r\n  \u001b[37m[o_o] kubelet\u001b[39m \u001b[2m. the executioner\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"I do not read your code. I read your manifest,\u001b[39m\u001b[48X\r\n        \u001b[37mand then I pull the trigger.\"\u001b[39m\u001b[66X\u001b[9;103H\u001b[1K\r\n  \u001b[35m\u001b[1m(~_~) Postgres\u001b(B\u001b[m \u001b[2m. the database\u001b(B\u001b[m\u001b[72X\r\n        \u001b[37m\"Two vCPU, 54 connections you may have,\u001b[39m\u001b[56X\r\n        \u001b[37mand a great deal of patience.\"\u001b[39m\u001b[65X\u001b[13;103H\u001b[1K\r\n  \u001b[31m\u001b[1m[>_<] KEDA\u001b(B\u001b[m \u001b[2m. the pod autoscaler\u001b(B\u001b[m\u001b[70X\r\n        \u001b[37m\"The queue is deep, so I will add workers.\"\u001b[39m\u001b[52X\r\n        \u001b[37mIt has no other ideas.\u001b[39m\u001b[73X\u001b[17;103H\u001b[1K\r\n  \u001b[36m\u001b[1m[$_$] Karpenter\u001b(B\u001b[m \u001b[2m. the node autoscaler\u001b(B\u001b[m\u001b[64X\r\n        \u001b[37m\"Pods are Pending, so I will buy machines.\"\u001b[39m\u001b[52X\r\n        \u001b[37mThis one has a credit card.\u001b[39m\u001b[68X\u001b[21;103H\u001b[1K\r\n  \u001b[2mAny resemblance to your team i"]
