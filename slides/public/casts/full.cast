[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[2d  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mTwenty-four workers at four connections is ninety-six. I have fifty-seven.\u001b[39m         \r\n  \u001b[35m\u001b[1m(~_~) Postgres \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mAnd two vCPU, which are now entirely yours.\u001b[39m\u001b[40X\u001b[4;103H\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl exec -n demo deploy/dbshell -- sh -c \"psql \\\"\\$DSN\\\" -c \\\"SELECT state, count(*),\u001b(B\u001b[m\u001b[10X\r\n    \u001b[36m\u001b[1mmax(now()-query_start)::interval(0) AS longest FROM pg_stat_activity WHERE\u001b(B\u001b[m\u001b[25X\r\n    \u001b[36m\u001b[1mdatname=current_database() GROUP BY state ORDER BY 2 DESC\\\"\"\u001b(B\u001b[m\u001b[39X\r\n   state  | count | longest\u001b[76X\r\n  --------+-------+----------\u001b[74X\r\n   idle   |     8 | 00:00:23\u001b[75X\r\n   active |     1 | 00:00:00\u001b[75X\r\n  (2 rows)\u001b[93X\u001b[13;103H\u001b[1K\n\u001b[1K\r\n  \u001b[36m\u001b[1m$ kubectl -n demo logs -l app=worker --tail=3 --prefix 2>/dev/null | grep -i 'too many\\|pool\u001b(B\u001b[m         \r\n    \u001b[36m\u001b[1mat\\|process:' | tail -8\u001b(B\u001b[m\u001b[76X\r\n  \u001b[33m\u001b[1m-> exit 1\u001b(B\u001b[m\u001b[92X\r\n  \u001b[34m\u001b[1m(o_o) Timur    \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37m\"too many connections"]
