[0.000, "o", "\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
[0.006, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[37mThe queue will not go down -- two thousand a second go in, and twelve workers cannot outrun that.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[37mWatch the other two numbers.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
