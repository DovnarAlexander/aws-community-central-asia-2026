[0.0, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H    \u001b[36m\u001b[1mdatname=current_database() GROUP BY state ORDER BY 2 DESC\\\"\"\u001b(B\u001b[m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
