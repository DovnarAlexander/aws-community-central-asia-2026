[0.021, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[44;103H\n\u001b[2;44r\u001b[s\u001b[43;1H  \u001b[32m\u001b[1m(^_^) Madina   \u001b(B\u001b[m \u001b[2m>\u001b(B\u001b[m \u001b[37mBefore it ships. These two are not the same question.\u001b[39m\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?2026l"]
