[0.023, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[12S\u001b[2;44r\u001b[s\u001b[32;1H  \u001b[36m@@ -1,8 +1,16 @@\r\n\u001b[39m  \u001b[31m-# Incident 1, step 1.1 -- the probe Timur copied out of a blog post.\u001b[39m\u001b[32X\r\n  \u001b[32m+# Incident 1, step 1.2 -- Ruslan fixes production the way Ruslan fixes production.\u001b[39m\u001b[18X\r\n   #\u001b[99X\r\n  \u001b[31m-# The service takes 30 seconds to warm up. The probe starts asking after 5, and\u001b[39m\u001b[21X\r\n  \u001b[31m-# gives up after three misses at 5-second intervals. 5 + 3x5 = 20 seconds of\u001b[39m\u001b[24X\r\n  \u001b[31m-# patience against 30 seconds of startup. Nothing here is a bug, and the pod\u001b[39m\u001b[24X\r\n  \u001b[31m-# dies every single time.\u001b[39m\u001b[75X\r\n  \u001b[32m+# 25 is bigger than 15, the CrashLoop stops, and the fix holds until the day the\u001b[39m\u001b[20X\r\n  \u001b[32m+# service starts taking longer. It is a bet that tomorrow looks like today.\u001b[39m\u001b[25X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# These numbers used to be 40 against 30. They are half that now because the\u001b[39m\u001b[24X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
[0.0, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[17S\u001b[2;44r\u001b[s\u001b[27;1H  \u001b[32m+# failure is pure arithmetic -- initialDelay + failureThreshold x period against\r\n\u001b[39m  \u001b[32m+# the warmup -- and arithmetic is as true at 25 seconds as at 40. What the\u001b[39m\u001b[26X\r\n  \u001b[32m+# halving bought is most of a minute of stage time, which the theory cards now\u001b[39m\u001b[22X\r\n  \u001b[32m+# spend explaining the probe while the rollout settles.\u001b[39m\u001b[45X\r\n  \u001b[32m+#\u001b[39m\u001b[99X\r\n  \u001b[32m+# Green here:  warmup 15 < initialDelay 25, ten seconds of margin.\u001b[39m\u001b[34X\r\n  \u001b[32m+# Broken next: the step sets WARMUP_SECONDS=50 against 25 + 3x5 = 40 seconds of\u001b[39m\u001b[21X\r\n  \u001b[32m+# patience, so the kill lands at 40 and the pod would have been ready at 50.\u001b[39m\u001b[24X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -32,5 +40,5 @@\u001b[39m spec:\u001b[78X\r\n             env:\u001b[86X\r\n               - name: WARMUP_SECONDS\u001b[66X\r\n  \u001b[31m-              value: \"30\"\u001b[39m\u001b[75X\r\n  \u001b[32m+              value: \"15\"\u001b[39m\u001b[75X\r\n               - name: HEALTHZ_MODE\u001b[68X\r\n     "]
[0.001, "o", "            value: \"local\"\u001b[72X\r\n  \u001b[36m@@ -44,5 +52,5 @@\u001b[39m \u001b[83X\u001b[1;44r\u001b[44;21H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[7S\u001b[2;44r\u001b[s\u001b[37;21Hspec:\r\n             livenessProbe:\u001b[76X\r\n               httpGet: { path: /healthz, port: 8080 }\u001b[49X\r\n  \u001b[31m-            initialDelaySeconds: 5\u001b[39m\u001b[66X\r\n  \u001b[32m+            initialDelaySeconds: 25\u001b[39m\u001b[65X\r\n               periodSeconds: 5\u001b[72X\r\n               timeoutSeconds: 1\u001b[71X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l"]
