[0.024, "o", "\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[13S\u001b[2;44r\u001b[s\u001b[31;1H  \u001b[36m@@ -1,11 +1,11 @@\r\n\u001b[39m  \u001b[31m-# Incident 1, step 1.3 -- the production configuration, and the first real traffic.\u001b[39m\u001b[17X\r\n  \u001b[32m+# Incident 1, step 1.4 -- the fix, which is two changes and no new code.\u001b[39m\u001b[28X\r\n   #\u001b[99X\r\n  \u001b[31m-# The start is fixed, so the warmup drops to 10 seconds and the replica count\u001b[39m\u001b[23X\r\n  \u001b[31m-# goes to three. Nobody touched the liveness probe, because it is green.\u001b[39m\u001b[28X\r\n  \u001b[32m+# HEALTHZ_MODE=local: liveness answers \"is this process alive\" without leaving\u001b[39m\u001b[22X\r\n  \u001b[32m+# the process. It cannot be starved by the work the process is doing.\u001b[39m\u001b[31X\r\n   #\u001b[99X\r\n  \u001b[31m-# HEALTHZ_MODE=db is the whole step: /healthz now queues for the same worker\u001b[39m\u001b[24X\r\n  \u001b[31m-# slot and the same pooled connection that /work is using. Under load the queue\u001b[39m\u001b[21X\r\n  \u001b[31m-# grows past timeoutSeconds: 1, three checks in a row miss, and kubelet restarts\u001b[39m\u001b[20X\r\n  \u001b[31m-# three entirely healthy replicas for b"]
[0.0, "o", "eing busy.\u001b[39m\u001b[51X\u001b[44;103H\u001b[1K\u001b[1;44r\u001b[44;1H\u001b[?2026l\u001b[?2026h\u001b[2;44r\u001b[2;44r\u001b[1;103s\u001b[1;1H\u001b[21S\u001b[2;44r\u001b[s\u001b[23;1H  \u001b[32m+# And the numbers get slack: 10-second period, 3-second timeout, five misses.\r\n\u001b[39m  \u001b[32m+# A liveness probe should be the last resort, not the first responder -- taking\u001b[39m\u001b[21X\r\n  \u001b[32m+# a busy replica out of the load balancer is readiness' job, and readiness stays\u001b[39m\u001b[20X\r\n  \u001b[32m+# tight on purpose.\u001b[39m\u001b[81X\r\n   apiVersion: apps/v1\u001b[81X\r\n   kind: Deployment\u001b[84X\r\n  \u001b[36m@@ -41,5 +41,5 @@\u001b[39m spec:\u001b[78X\r\n                 value: \"4\"\u001b[76X\r\n               - name: HEALTHZ_MODE\u001b[68X\r\n  \u001b[31m-              value: \"db\"\u001b[39m\u001b[75X\r\n  \u001b[32m+              value: \"local\"\u001b[39m\u001b[72X\r\n               - name: READY_MODE\u001b[70X\r\n                 value: \"cached\"\u001b[71X\r\n  \u001b[36m@@ -56,7 +56,7 @@\u001b[39m spec:\u001b[78X\r\n             livenessProbe:\u001b[76X\r\n               httpGet: { path: /healthz, port: 8080 }\u001b[49X\r\n  \u001b[31m-            periodSeconds: 5\u001b[39m\u001b[72X\r\n  \u001b[31m-            timeoutSeconds: 1\u001b[39m\u001b[71X\r\n  "]
